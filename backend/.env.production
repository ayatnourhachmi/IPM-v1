# Production environment variables template for Render deployment
# Copy secrets from a password manager into the Render/Vercel dashboards — avoid committing keys.

# Database (Neon)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Deployment settings
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=http://localhost:3000,https://your-vercel-url.vercel.app

# API metadata
API_TITLE=IPM API
API_VERSION=0.1.0
API_DESCRIPTION=Intelligent Project Management API

# LLM Provider (Groq)
LLM_PROVIDER=groq
GROQ_API_KEY=

# Embeddings (local sentence-transformers)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-en-v1.5

# Pinecone (vectors: business_need duplicates + dxc_catalog)
PINECONE_API_KEY=
PINECONE_INDEX=ipm-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_INDEX_DIMENSION=384
PINECONE_AUTO_CREATE_INDEX=false
PINECONE_SEED_CATALOG_ON_STARTUP=true

# Langfuse (Observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional object storage / local tooling
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
