# Database
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/database?sslmode=require

# Deployment
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# API metadata
API_TITLE=IPM API
API_VERSION=0.1.0
API_DESCRIPTION=Intelligent Project Management API

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Embeddings
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_OPENAI=text-embedding-ada-002

# ChromaDB / MinIO for local development only
CHROMA_HOST=chromadb
CHROMA_PORT=8001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Pinecone (vector database)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
# Langfuse (observability / monitoring)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com